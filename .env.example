DATABASE_URL=
SESSION_SECRET=
EMAIL_SETTINGS_ENCRYPTION_KEY=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=
AUTH_LOGOUT_REDIRECT_URI=
# Optional override for the "Manage account in Authentik" link in User Profile.
AUTH_ACCOUNT_URL=
AUTH_SCOPE=openid profile email
AUTH_BOOTSTRAP_ADMIN_EMAILS=
# Optional proxy/session tuning for production auth callbacks.
# SESSION_TRUST_PROXY supports: true, false, or numeric hops (default: 1).
SESSION_TRUST_PROXY=1
# SESSION_COOKIE_SECURE supports: true, false, or leave empty for auto behavior.
SESSION_COOKIE_SECURE=
PORT=5000
GOOGLE_MAPS_API_KEY=
